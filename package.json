{
  "name": "strandline",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --import ./tools/test/loader.mjs --test tools/test/frontend.test.mts",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "sandbox": "cargo run --manifest-path src-tauri/Cargo.toml --bin sandbox-gen -- sandbox/demo",
    "test:backend": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint:backend": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "fonts": "node tools/fonts/fetch.mjs",
    "smoke": "node tools/e2e/smoke.mjs",
    "shots": "node tools/e2e/shots.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "description": "Strandline · 拾滩 — a safety-first disk organizer for Windows (Tauri v2 + React)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qua-Drant/strandline.git"
  },
  "homepage": "https://qua-drant.github.io/strandline/",
  "bugs": {
    "url": "https://github.com/Qua-Drant/strandline/issues"
  }
}
